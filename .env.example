# ============================================================================
# PUVIMA Consultancy — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env containing real credentials or secrets to version control.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5000

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=puvima_db
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Security, JWT & Administrative Access
ADMIN_EMAIL=admin@puvima.com
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=puvima_consultancy_super_secure_jwt_secret_token_2026
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Careers & Resume Storage Security
MAX_RESUME_SIZE_BYTES=5242880

# ============================================================================
# Google Drive API Resume Storage Integration
# Uploads candidate resumes directly into PUVIMA's private recruitment folder.
# Dedicated folder path: "PUVIMA Consultancy / Recruitment / Internship Applications"
# ============================================================================
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J_your_designated_folder_id

# ============================================================================
# Recruitment Notification Email (Nodemailer SMTP)
# Dispatches notifications with candidate data and Google Drive resume link.
# ============================================================================
RECRUITMENT_EMAIL=contact@puvima.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@puvima.com
SMTP_PASS=your-app-specific-password
MAIL_FROM=contact@puvima.com

# Notification Integrations (General Inquiries & Bookings)
EMAIL_FROM=contact@puvima.com
NOTIFICATION_RECIPIENT=contact@puvima.com

# ============================================================================
# PUVIMA Mail — Dedicated Mailbox Integration (IMAP & SMTP)
# ============================================================================
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=admin@puvima.com
IMAP_PASS=your-email-password

# Supabase Database Configuration (PostgreSQL Cloud)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
