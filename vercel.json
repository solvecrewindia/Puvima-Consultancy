{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin.css",
      "destination": "/admin/admin.css"
    },
    {
      "source": "/admin.js",
      "destination": "/admin/admin.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/login",
      "destination": "/pages/login.html"
    },
    {
      "source": "/company",
      "destination": "/company/index.html"
    },
    {
      "source": "/company/login",
      "destination": "/pages/login.html"
    },
    {
      "source": "/company/admin",
      "destination": "/company/admin.html"
    },
    {
      "source": "/company/hr",
      "destination": "/company/hr.html"
    },
    {
      "source": "/company/employee",
      "destination": "/company/employee.html"
    },
    {
      "source": "/company/intern",
      "destination": "/company/intern.html"
    },
    {
      "source": "/company/about",
      "destination": "/company/about.html"
    },
    {
      "source": "/careers",
      "destination": "/pages/careers.html"
    },
    {
      "source": "/contact",
      "destination": "/pages/contact.html"
    },
    {
      "source": "/booking",
      "destination": "/pages/booking.html"
    },
    {
      "source": "/services",
      "destination": "/pages/services.html"
    },
    {
      "source": "/about",
      "destination": "/pages/about.html"
    },
    {
      "source": "/portfolio",
      "destination": "/pages/portfolio.html"
    },
    {
      "source": "/testimonials",
      "destination": "/pages/testimonials.html"
    },
    {
      "source": "/team",
      "destination": "/pages/team.html"
    },
    {
      "source": "/faq",
      "destination": "/pages/faq.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/pages/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/pages/terms.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{backend/data/**,data/**}"
    },
    "index.js": {
      "includeFiles": "{backend/data/**,data/**}"
    }
  }
}
