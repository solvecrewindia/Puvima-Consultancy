# ============================================================================
# PUVIMA Consultancy — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env containing real credentials or secrets to version control.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5000

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=puvima_db
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Security, JWT & Administrative Access
ADMIN_EMAIL=admin@puvima.com
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=puvima_consultancy_super_secure_jwt_secret_token_2026
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Careers & Resume Storage Security
# Max allowed file size in bytes (5 MB = 5242880)
MAX_RESUME_SIZE_BYTES=5242880

# ============================================================================
# PUVIMA Mail — Dedicated Mailbox Integration (IMAP & SMTP)
# Connects to your existing custom-domain business mailbox (e.g. admin@puvima.com)
# ============================================================================

# IMAP Inbound Mailbox Configuration (imapflow)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=admin@puvima.com
IMAP_PASS=your-email-password

# SMTP Outbound Dispatch Configuration (nodemailer)
# Port 465 uses SSL/TLS (SMTP_SECURE=true)
# Port 587 uses STARTTLS (SMTP_SECURE=false)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@puvima.com
SMTP_PASS=your-email-password
MAIL_FROM=admin@puvima.com

# Notification Integrations (General Inquiries & Bookings)
EMAIL_FROM=contact@puvima.com
NOTIFICATION_RECIPIENT=contact@puvima.com

# Supabase Database Configuration (PostgreSQL Cloud)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
