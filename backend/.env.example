# ============================================================================
# PUVIMA Consultancy — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env containing real credentials or secrets to version control.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5000

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=puvima_db
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Future Notification Integrations (Optional)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=advisory@puvima.com
NOTIFICATION_RECIPIENT=advisory@puvima.com
